<mxfile host="app.diagrams.net"><diagram id="hinh_5_4_xac_thuc_jwt" name="hinh_5_4_xac_thuc_jwt"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="460"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Xác thực bằng JWT và phân quyền theo vai trò" style="text;html=1;align=center;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="200.0" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="3" value="1. Ứng dụng gửi&#xa;POST /api/auth/login&#xa;(tên đăng nhập, mật khẩu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="230" height="90" as="geometry"/></mxCell><mxCell id="4" value="2. AuthController đối chiếu&#xa;bản băm bcrypt, trạng thái&#xa;HOAT_DONG; ghi audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="60" width="260" height="90" as="geometry"/></mxCell><mxCell id="5" value="3. JwtService.taoToken&#xa;ký HMAC-SHA, hết hạn 60 phút&#xa;claim: uid, role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="260" height="90" as="geometry"/></mxCell><mxCell id="6" value="4. Trả về token, vai trò&#xa;Ứng dụng lưu token&#xa;(ghi nhớ: shared_preferences)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="60" width="230" height="90" as="geometry"/></mxCell><mxCell id="7" value="5. Mỗi yêu cầu sau đó gửi&#xa;Authorization: Bearer &lt;token&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="230" height="90" as="geometry"/></mxCell><mxCell id="8" value="6. JwtAuthFilter kiểm tra chữ ký&#xa;và hạn; nạp NguoiDungHienTai&#xa;vào SecurityContext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="260" width="260" height="90" as="geometry"/></mxCell><mxCell id="9" value="7. SecurityConfig phân quyền theo đường dẫn&#xa;/api/admin → QUAN_TRI_VIEN&#xa;/api/nhan-vien → NHAN_VIEN&#xa;/api/cu-dan → CU_DAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="260" width="260" height="110" as="geometry"/></mxCell><mxCell id="10" value="8. Controller → Service&#xa;Trái vai trò: 403&#xa;Chưa đăng nhập: 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="260" width="230" height="90" as="geometry"/></mxCell><mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="đúng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="8" target="9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="9" target="10"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>