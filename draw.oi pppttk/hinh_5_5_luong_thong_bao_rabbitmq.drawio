<mxfile host="app.diagrams.net"><diagram id="hinh_5_5_luong_thong_bao_rabbitmq" name="hinh_5_5_luong_thong_bao_rabbitmq"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1280" pageHeight="460"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Luồng phát thông báo bất đồng bộ qua RabbitMQ" style="text;html=1;align=center;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="240.0" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="3" value="Sự kiện nghiệp vụ&#xa;T5 (tiếp nhận), danh_dau_qua_han&#xa;Ghi dòng thong_bao: CHO_GUI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="260" height="100" as="geometry"/></mxCell><mxCell id="4" value="View v_thong_bao_chua_gui&#xa;(kèm sdt, email cư dân)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="240" height="100" as="geometry"/></mxCell><mxCell id="5" value="ThongBaoDispatcher&#xa;@Scheduled mỗi 10 giây&#xa;Lấy tối đa 50 thông báo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="60" width="260" height="100" as="geometry"/></mxCell><mxCell id="6" value="Hàng đợi thong_bao.gui&#xa;(bền, mặc định của RabbitMQ)&#xa;Tin: id|kênh|đích|nội dung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="60" width="280" height="100" as="geometry"/></mxCell><mxCell id="7" value="ThongBaoConsumer&#xa;@RabbitListener" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="260" width="280" height="110" as="geometry"/></mxCell><mxCell id="8" value="UPDATE thong_bao&#xa;SET DA_GUI WHERE CHO_GUI&#xa;(chỉ khi còn CHO_GUI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="260" width="260" height="110" as="geometry"/></mxCell><mxCell id="9" value="Ghi log &quot;[GIA LAP kênh → đích]&quot;&#xa;(giả lập SMS/Email/APP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="340" y="260" width="240" height="110" as="geometry"/></mxCell><mxCell id="10" value="đọc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="SELECT … LIMIT 50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="convertAndSend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="giao tin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" value="1 dòng được cập nhật" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="8" target="9"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>