<mxfile host="app.diagrams.net"><diagram id="so-do-to-chuc" name="So do to chuc he thong"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="BAN QUẢN LÝ TÒA NHÀ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="330" y="20" width="300" height="50" as="geometry"/></mxCell><mxCell id="3" value="BỘ PHẬN TIẾP NHẬN &amp; LƯU KHO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="280" height="50" as="geometry"/></mxCell><mxCell id="4" value="CƯ DÂN &amp; ĐƠN VỊ VẬN CHUYỂN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="280" height="50" as="geometry"/></mxCell><mxCell id="5" value="BỘ PHẬN KỸ THUẬT &amp; QUẢN TRỊ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="130" width="280" height="50" as="geometry"/></mxCell><mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#555555;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#555555;" edge="1" parent="1" source="2" target="4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#555555;" edge="1" parent="1" source="2" target="5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;Tổ Tiếp nhận bưu kiện&lt;/b&gt;&lt;br&gt;Nhân viên (bảo vệ, lễ tân): tra cứu căn hộ, tiếp nhận, xem bưu kiện đang lưu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="280" height="90" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;Tổ Xử lý bưu kiện quá hạn&lt;/b&gt;&lt;br&gt;Nhân viên: xem danh sách quá hạn, hoàn trả hoặc chuyển kho" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="280" height="80" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;Cư dân&lt;/b&gt;&lt;br&gt;Xem bưu kiện, thông báo, vị trí tủ; lấy mã nhận một lần; nhận bằng mã" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="230" width="280" height="90" as="geometry"/></mxCell><mxCell id="12" value="&lt;b&gt;Đơn vị vận chuyển (Shipper)&lt;/b&gt;&lt;br&gt;Giao bưu kiện đến tòa nhà; chức năng trên hệ thống CHƯA hiện thực" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=12;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="350" width="280" height="80" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;Tổ Vận hành hệ thống&lt;/b&gt;&lt;br&gt;Theo dõi tổng quan, thống kê tủ, nhật ký audit; cấu hình hạn lưu kho" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="660" y="230" width="280" height="90" as="geometry"/></mxCell><mxCell id="14" value="&lt;b&gt;Tổ Quản lý tài khoản &amp; danh mục&lt;/b&gt;&lt;br&gt;Quản trị viên: nhân viên, cư dân, căn hộ, tủ locker, email tài khoản" style="rounded=1;whi